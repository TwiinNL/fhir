      </reference>
      <name value="Patient"/>
      <description value="The Patient to which the Request refers. Carries the BSN in Patient.identifier (TA section Patient context and readability)."/>
      <exampleBoolean value="true"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="ServiceRequest"/>
