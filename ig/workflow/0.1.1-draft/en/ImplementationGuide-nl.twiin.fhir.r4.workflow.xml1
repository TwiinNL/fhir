      </reference>
      <name value="Subscription for a HealthcareService"/>
      <description value="Subscription for one HealthcareService and one topic at the base URL of the Placer: filter owner:identifier, id-only, heartbeat period (TA section Subscription). The topic URL is an example; topics are defined per use case."/>
      <exampleCanonical value="https://fhir.twiin.nl/ig/workflow/StructureDefinition/twiin-workflow-subscription"/>
    </resource>
