      <reference>
        <reference value="ValueSet/ta-workflow-status-reason"/>
      </reference>
      <name value="TA Workflow Status Reason"/>
      <description value="Codes for Task.statusReason of the Coordination Task under TA Workflow. Extensible: a use case or a Fulfiller MAY use other reasons, for instance when it rejects a Task; not-selected is reserved for the Placer."/>
      <exampleBoolean value="false"/>
    </resource>
