      </reference>
      <name value="Authorization Cancellation Request Task"/>
      <description value="A Fulfiller asks the Placer to withdraw the Request (TA section Cancellation by the Fulfiller). requester identifies the Fulfiller and owner the Placer, each by its URA."/>
      <exampleCanonical value="https://fhir.twiin.nl/ig/workflow/StructureDefinition/twiin-authorization-cancellation-request-task"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="Task"/>
      </extension>
      <reference>
        <reference value="Task/5b9d3e7f-1a2c-4f6e-8d4b-9e2a7c1f3b56"/>
      </reference>
      <name value="Cancellation Request Task"/>
      <description value="The Placer asks the Fulfiller to stop work that has started. focus refers to the Coordination Task, owner and the type of work are the same as on that Task (TA sections Cancellation Request Task; Cancellation Request (After in-progress))."/>
      <exampleCanonical value="https://fhir.twiin.nl/ig/workflow/StructureDefinition/twiin-cancellation-request-task"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="Task"/>
      </extension>
      <reference>
        <reference value="Task/6d2e9f41-8b3c-4a7d-b5e2-1c9f7a3d8e64"/>
      </reference>
      <name value="Coordination Task: candidate invited"/>
      <description value="A bidding task in the Multiple Fulfillers Pattern before selection: code request-fulfillment, for empty (TA sections Multiple Fulfillers Pattern; Patient context and readability)."/>
      <exampleCanonical value="https://fhir.twiin.nl/ig/workflow/StructureDefinition/twiin-coordination-task"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="Task"/>
      </extension>
      <reference>
        <reference value="Task/c8e3d5a7-2b4f-4d9e-a1c6-7f3b8e2d4a91"/>
      </reference>
      <name value="Coordination Task: candidate not selected"/>
      <description value="The Coordination Task of a candidate that was not selected: status cancelled with statusReason not-selected and the text not selected (TA section Reason for cancelling a non-selected candidate)."/>
      <exampleCanonical value="https://fhir.twiin.nl/ig/workflow/StructureDefinition/twiin-coordination-task"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="Task"/>
      </extension>
      <reference>
        <reference value="Task/a41c7e2b-5f9d-4e3a-8c6b-2d7f1e9a5b38"/>
      </reference>
      <name value="Coordination Task: candidate selected"/>
      <description value="The Coordination Task of the selected candidate: businessStatus selected, code fulfill and for set in the same update (TA sections Multiple Fulfillers Pattern; Patient context and readability). The candidate had accepted and recorded a bid in output."/>
      <exampleCanonical value="https://fhir.twiin.nl/ig/workflow/StructureDefinition/twiin-coordination-task"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="Task"/>
