       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Authorization Cancellation Request Task" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "A Fulfiller asks the Placer to withdraw the Request (TA section Cancellation by the Fulfiller). requester identifies the Fulfiller and owner the Placer, each by its URA." ] ;
