       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Cancellation Request Task" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "The Placer asks the Fulfiller to stop work that has started. focus refers to the Coordination Task, owner and the type of work are the same as on that Task (TA sections Cancellation Request Task; Cancellation Request (After in-progress))." ] ;
       fhir:ImplementationGuide.definition.resource.exampleCanonical [
