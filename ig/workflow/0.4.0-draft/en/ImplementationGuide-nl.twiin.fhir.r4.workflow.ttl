         fhir:Reference.reference [ fhir:value "Task/9c4a1f8e-7d3b-4e2a-b6f9-3a8e5d2c7b14" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Authorization Cancellation Request Task" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "A Fulfiller asks the Placer to withdraw the Request (TA section Cancellation by the Fulfiller). requester identifies the Fulfiller and owner the Placer, each by its URA. reasonCode carries the reason of the Fulfiller." ] ;
       fhir:ImplementationGuide.definition.resource.exampleCanonical [
         fhir:value "https://fhir.twiin.nl/ig/workflow/StructureDefinition/twiin-authorization-cancellation-request-task" ;
