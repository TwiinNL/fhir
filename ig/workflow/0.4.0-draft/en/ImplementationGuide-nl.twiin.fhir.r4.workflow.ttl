         fhir:Reference.reference [ fhir:value "Task/6d2e9f41-8b3c-4a7d-b5e2-1c9f7a3d8e64" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Coordination Task: candidate invited" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "A bidding task in the Multiple Fulfillers Pattern before selection: code request-fulfillment, for empty (TA sections Multiple Fulfillers Pattern; Patient context and readability). Task.input also carries a non-identifying entry with its content inline, as allowed before selection (TA sections Sharing additional content; Patient context and readability)." ] ;
