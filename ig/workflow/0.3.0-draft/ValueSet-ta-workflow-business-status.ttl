  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "extensions" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: ValueSet ta-workflow-business-status</b></p><a name=\"ta-workflow-business-status\"> </a><a name=\"hcta-workflow-business-status\"> </a><ul><li>Include these codes as defined in <a href=\"CodeSystem-ta-workflow.html\"><code>https://fhir.twiin.nl/ig/workflow/CodeSystem/ta-workflow</code></a><span title=\"Version is not explicitly stated, which means it is fixed to the version provided in this specification\"> version ?0.3.0-draft</span><table class=\"none\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr><tr><td><a href=\"CodeSystem-ta-workflow.html#ta-workflow-selected\">selected</a></td><td style=\"color: #cccccc\">Selected</td><td>The Placer has selected the owner of this Task as the Fulfiller.</td></tr><tr><td><a href=\"CodeSystem-ta-workflow.html#ta-workflow-awaiting-information\">awaiting-information</a></td><td style=\"color: #cccccc\">Awaiting information</td><td>The Fulfiller needs more information from the Placer to continue or to decide.</td></tr><tr><td><a href=\"CodeSystem-ta-workflow.html#ta-workflow-visit-scheduled\">visit-scheduled</a></td><td style=\"color: #cccccc\">Visit scheduled</td><td>A visit with the patient is scheduled.</td></tr></table></li></ul></div>"
