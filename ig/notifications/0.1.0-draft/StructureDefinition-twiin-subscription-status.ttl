       fhir:Element.id [ fhir:value "Parameters" ] ;
       fhir:ElementDefinition.path [ fhir:value "Parameters" ] ;
       fhir:ElementDefinition.short [ fhir:value "Parameter containing subscription status information" ] ;
       fhir:ElementDefinition.definition [ fhir:value "This resource is a non-persisted resource used to pass information into and back from an [operation](http://hl7.org/fhir/R4/operations.html). It has no other use, and there is no RESTful endpoint associated with it." ] ;
       fhir:ElementDefinition.comment [ fhir:value "The parameters that may be used are defined by the OperationDefinition resource." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "Parameters" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "*" ]
       ] ;
       fhir:ElementDefinition.constraint [
         fhir:index 0 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "twiin-st-1" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "The subscription reference is an absolute http(s) URL." ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "parameter.where(name = 'subscription').all(value.reference.exists() and value.reference.matches('^https?://[^ ]+$'))" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "https://fhir.twiin.nl/ig/notifications/StructureDefinition/twiin-subscription-status" ;
           fhir:link <https://fhir.twiin.nl/ig/notifications/StructureDefinition/twiin-subscription-status>
         ]
       ], [
         fhir:index 1 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "twiin-st-2" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "If type is event-notification, there is a notification-event, and every notification-event carries event-number and timestamp." ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "parameter.where(name = 'type' and value = 'event-notification').exists() implies (parameter.where(name = 'notification-event').exists() and parameter.where(name = 'notification-event').all(part.where(name = 'event-number').exists() and part.where(name = 'timestamp').exists()))" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "https://fhir.twiin.nl/ig/notifications/StructureDefinition/twiin-subscription-status" ;
           fhir:link <https://fhir.twiin.nl/ig/notifications/StructureDefinition/twiin-subscription-status>
